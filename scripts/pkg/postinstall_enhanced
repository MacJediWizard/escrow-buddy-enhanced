# Enhanced postinstall script with migration support
set -e

# Variables
INSTALL_LOCATION="$3"
BUNDLE_PATH="$INSTALL_LOCATION/Library/Security/SecurityAgentPlugins/Escrow Buddy.bundle"
PREFS_PATH="/Library/Preferences/com.netflix.Escrow-Buddy.plist"
DB_DIR="/var/db"
LOG_FILE="/var/log/escrow-buddy-install.log"

# Logging function
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S'): $1" | tee -a "$LOG_FILE"
}

log "=== Starting Escrow Buddy Enhanced Installation ==="
log "Install location: $INSTALL_LOCATION"

# Check if this is an upgrade
if [ -f "$BUNDLE_PATH/Contents/Info.plist" ]; then
    OLD_VERSION=$(defaults read "$BUNDLE_PATH/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "unknown")
    log "Upgrading from version: $OLD_VERSION"
    IS_UPGRADE=true
else
    log "Fresh installation"
    IS_UPGRADE=false
fi

# Add to authorization database
log "Adding Escrow Buddy to authorization database..."
if [ -x "$BUNDLE_PATH/Contents/Resources/AuthDBSetup.sh" ]; then
    "$BUNDLE_PATH/Contents/Resources/AuthDBSetup.sh"
    log "Authorization database updated successfully"
else
    log "ERROR: AuthDBSetup.sh not found or not executable"
    exit 1
fi

# Create required directories
log "Creating required directories..."
mkdir -p "$DB_DIR" 2>/dev/null || true
mkdir -p "/var/log" 2>/dev/null || true

# Set proper permissions on database directory
chmod 700 "$DB_DIR"
chown root:wheel "$DB_DIR"

# Create default configuration if it doesn't exist
if [ ! -f "$PREFS_PATH" ]; then
    log "Creating default configuration..."
    cat > "$PREFS_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AutoRotationEnabled</key>
    <false/>
    <key>RotationIntervalDays</key>
    <integer>90</integer>
    <key>MaxKeyAge</key>
    <integer>365</integer>
    <key>RotateAfterUse</key>
    <false/>
    <key>ComplianceStandard</key>
    <string>none</string>
    <key>EnableComplianceReporting</key>
    <false/>
    <key>EnableNotifications</key>
    <true/>
    <key>NotificationDaysBefore</key>
    <integer>7</integer>
</dict>
</plist>
EOF
    chmod 644 "$PREFS_PATH"
    chown root:wheel "$PREFS_PATH"
    log "Default configuration created"
else
    log "Configuration file already exists, preserving existing settings"
fi

# Migrate existing data if upgrading
if [ "$IS_UPGRADE" = true ]; then
    log "Performing upgrade migration..."
    
    # Check for existing GenerateNewKey preference
    if defaults read com.netflix.Escrow-Buddy GenerateNewKey 2>/dev/null; then
        GENERATE_KEY=$(defaults read com.netflix.Escrow-Buddy GenerateNewKey)
        log "Found existing GenerateNewKey preference: $GENERATE_KEY"
        
        # Preserve the setting
        defaults write com.netflix.Escrow-Buddy GenerateNewKey -bool "$GENERATE_KEY"
    fi
    
    # Migrate any existing key lifecycle data
    if [ -f "/var/db/escrow_buddy_lifecycle.plist" ]; then
        log "Found existing key lifecycle data, preserving..."
        cp "/var/db/escrow_buddy_lifecycle.plist" "/var/db/escrow_buddy_lifecycle.plist.backup"
    fi
    
    if [ -f "/var/db/escrow_buddy_history.plist" ]; then
        log "Found existing rotation history, preserving..."
        cp "/var/db/escrow_buddy_history.plist" "/var/db/escrow_buddy_history.plist.backup"
    fi
fi

# Set proper permissions on the bundle
log "Setting permissions on bundle..."
chmod -R 755 "$BUNDLE_PATH"
chown -R root:wheel "$BUNDLE_PATH"

# Create uninstall script
log "Creating uninstall script..."
cat > "/usr/local/bin/uninstall_escrow_buddy.sh" <<'UNINSTALL_SCRIPT'
#!/bin/bash

echo "Uninstalling Escrow Buddy Enhanced..."

# Remove from authorization database
if [ -x "/Library/Security/SecurityAgentPlugins/Escrow Buddy.bundle/Contents/Resources/AuthDBTeardown.sh" ]; then
    "/Library/Security/SecurityAgentPlugins/Escrow Buddy.bundle/Contents/Resources/AuthDBTeardown.sh"
fi

# Remove bundle
rm -rf "/Library/Security/SecurityAgentPlugins/Escrow Buddy.bundle"

# Remove preferences (optional - uncomment to remove)
# rm -f "/Library/Preferences/com.netflix.Escrow-Buddy.plist"

# Remove database files (optional - uncomment to remove)
# rm -f /var/db/escrow_buddy_*.plist

# Remove log files
rm -f /var/log/escrow-buddy*.log

# Remove this uninstall script
rm -f "$0"

echo "Escrow Buddy Enhanced has been uninstalled."
echo "Note: Configuration and database files have been preserved."
echo "To remove them, manually delete:"
echo "  - /Library/Preferences/com.netflix.Escrow-Buddy.plist"
echo "  - /var/db/escrow_buddy_*.plist"
UNINSTALL_SCRIPT

chmod 755 "/usr/local/bin/uninstall_escrow_buddy.sh"
chown root:wheel "/usr/local/bin/uninstall_escrow_buddy.sh"

# Verify installation
log "Verifying installation..."
if [ -f "$BUNDLE_PATH/Contents/Info.plist" ]; then
    NEW_VERSION=$(defaults read "$BUNDLE_PATH/Contents/Info.plist" CFBundleShortVersionString)
    log "Successfully installed Escrow Buddy Enhanced version: $NEW_VERSION"
else
    log "ERROR: Installation verification failed"
    exit 1
fi

# Check for Jamf Pro
if [ -f "/usr/local/jamf/bin/jamf" ]; then
    log "Jamf Pro detected, triggering inventory update..."
    /usr/local/jamf/bin/jamf recon 2>/dev/null || true
fi

log "=== Installation Complete ==="
log "To enable auto-rotation features, configure via MDM profile or use:"
log "  sudo defaults write /Library/Preferences/com.netflix.Escrow-Buddy AutoRotationEnabled -bool true"

exit 0